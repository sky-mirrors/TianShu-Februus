{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["core/**/*.mjs", "domains/**/*.mjs", "render/**/*.mjs", "tools/**/*.mjs", "bin/**/*.mjs", "index.js"]
}
